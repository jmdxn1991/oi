
---
const year = new Date().getFullYear();

const lessons = [
  {
    number: "01",
    title: "Market Microstructure and Liquidity Basics",
    id: "ece8e22d4c8bab1080123059337a5efd",
  },
  {
    number: "02",
    title: "Identifying Key Structures (Flags and Flag Limits)",
    id: "7195a57d5c24c8c7884cde1ad3aba05e",
  },
  {
    number: "03",
    title: "Market Structure (Engulf and FTR)",
    id: "e0bdd98b82052e3e13fa1407c672e1bc",
  },
  {
    number: "04",
    title: "Anticipating Volatility (Liquidity Gaps and Compression)",
    id: "90a1f82e53168f5ca2f47c85b90ac971",
  },
  {
    number: "05",
    title: "Navigating Scale (Trading Flow and Managing Expectations)",
    id: "799078cd2ca73d29cbb9b3901cb3971a",
  },
  {
    number: "06",
    title: "Volume Profile",
    id: "4075efd8f38c2ff75d860bd2f2202ea6",
  },
  {
    number: "07",
    title: "False Breaks",
    id: "48fb22e7eecdea58ba7ac2f24b2dd950",
  },
  {
    number: "08",
    title: "Orderflow Dynamics and the Footprint",
    id: "868cdd5af104fafc12705f9e01671186",
  },
  {
    number: "09",
    title: "Psychology",
    id: "a4ad8289e0b0997dc64dbc48f7ce38bc",
  },
];

const bonus = {
  number: "Q&A",
  title: "Questions and Answers",
  id: "f2b36697fc2208c7b44b2760d3a9aab0",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Explore the free Trading Mind trading course, covering market structure, liquidity, volatility, volume profile, orderflow and psychology."
    />
    <meta name="theme-color" content="#22241f" />
    <title>Free Trading Course — Trading Mind</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        color-scheme: dark;
        --paper: #22241f;
        --ink: #f1f0e9;
        --muted: #b5b5aa;
        --sage: #a4ad85;
        --line: #42443c;
        --button-text: #22241f;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 30px;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "DM Sans", sans-serif;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:focus-visible,
      summary:focus-visible {
        outline: 2px solid var(--sage);
        outline-offset: 5px;
      }

      header {
        width: 100%;
        padding: 30px 7.2%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        border-bottom: 1px solid var(--line);
      }

      .wordmark {
        font-size: 19px;
        line-height: 1;
        letter-spacing: -0.8px;
        white-space: nowrap;
      }

      .wordmark strong {
        font-weight: 650;
      }

      .wordmark span {
        font-weight: 400;
      }

      nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 30px;
      }

      nav a {
        color: var(--muted);
        font-size: 12px;
        transition: color 180ms ease;
      }

      nav a:hover,
      nav a[aria-current="page"] {
        color: var(--ink);
      }

      nav a[aria-current="page"] {
        border-bottom: 1px solid var(--sage);
        padding-bottom: 3px;
      }

      .hero {
        padding: 80px 7.2% 72px;
      }

      .hero-content {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
      }

      h1 {
        max-width: 760px;
        margin: 0;
        font-size: clamp(42px, 5.4vw, 70px);
        font-weight: 450;
        letter-spacing: -0.06em;
        line-height: 1.12;
      }

      h1 span {
        color: var(--sage);
      }

      .hero-description {
        max-width: 570px;
        margin: 23px 0 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.9;
      }

      .course-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        margin-top: 24px;
        color: var(--muted);
        font-size: 12px;
      }

      .course-meta span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .course-meta span::before {
        content: "";
        display: inline-block;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--sage);
      }

      .curriculum {
        padding: 0 7.2% 88px;
      }

      .curriculum-inner {
        max-width: 900px;
        margin: 0 auto;
      }

      .curriculum-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
        padding: 0 0 17px;
        border-bottom: 1px solid var(--line);
      }

      .curriculum-heading h2 {
        margin: 0;
        font-size: 19px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      .curriculum-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
      }

      .lesson {
        border-bottom: 1px solid var(--line);
      }

      .lesson summary {
        min-height: 76px;
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr) 20px;
        align-items: center;
        gap: 14px;
        padding: 17px 4px;
        cursor: pointer;
        list-style: none;
      }

      .lesson summary::-webkit-details-marker {
        display: none;
      }

      .lesson-number {
        color: var(--sage);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.02em;
      }

      .lesson-title {
        color: var(--ink);
        font-size: 14px;
        font-weight: 450;
        line-height: 1.6;
        transition: color 180ms ease;
      }

      .lesson summary:hover .lesson-title {
        color: var(--sage);
      }

      .lesson-toggle {
        position: relative;
        width: 18px;
        height: 18px;
        justify-self: end;
      }

      .lesson-toggle::before,
      .lesson-toggle::after {
        content: "";
        position: absolute;
        top: 8px;
        left: 3px;
        width: 12px;
        height: 1px;
        background: var(--muted);
        transition: transform 180ms ease;
      }

      .lesson-toggle::after {
        transform: rotate(90deg);
      }

      .lesson[open] .lesson-toggle::after {
        transform: rotate(0deg);
      }

      .lesson-content {
        padding: 0 4px 28px 60px;
      }

      .video-wrap {
        position: relative;
        width: 100%;
        overflow: hidden;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--line);
        border-radius: 4px;
        background: #171814;
      }

      .video-wrap iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      .contact {
        border-top: 1px solid var(--line);
        padding: 76px 7.2% 82px;
        text-align: center;
      }

      .contact h2 {
        margin: 0;
        font-size: clamp(28px, 3.2vw, 38px);
        font-weight: 450;
        letter-spacing: -0.045em;
        line-height: 1.3;
      }

      .contact p {
        max-width: 410px;
        margin: 15px auto 0;
        color: var(--muted);
        font-size: 14px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 25px;
        padding: 12px 19px;
        border: 1px solid var(--ink);
        border-radius: 4px;
        background: var(--ink);
        color: var(--button-text);
        font-family: inherit;
        font-size: 12px;
        font-weight: 550;
        line-height: 1.5;
        transition:
          background 180ms ease,
          color 180ms ease,
          border-color 180ms ease;
      }

      .button:hover {
        background: transparent;
        border-color: var(--sage);
        color: var(--sage);
      }

      footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-top: 1px solid var(--line);
        padding: 25px 7.2%;
      }

      footer .wordmark {
        font-size: 16px;
      }

      footer p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
      }

      @media (min-width: 1400px) {
        .hero {
          padding-top: 100px;
          padding-bottom: 85px;
        }
      }

      @media (max-width: 700px) {
        header {
          padding: 24px 6%;
          align-items: flex-start;
          flex-direction: column;
          gap: 23px;
        }

        nav {
          width: 100%;
          justify-content: flex-start;
          flex-wrap: wrap;
          gap: 13px 23px;
        }

        .hero {
          padding: 61px 6% 54px;
        }

        h1 {
          font-size: clamp(42px, 10vw, 62px);
          letter-spacing: -0.06em;
        }

        .hero-description {
          margin-top: 20px;
          font-size: 14px;
        }

        .curriculum {
          padding: 0 6% 65px;
        }

        .curriculum-heading {
          align-items: flex-start;
          flex-direction: column;
          gap: 4px;
        }

        .lesson summary {
          grid-template-columns: 32px minmax(0, 1fr) 18px;
          gap: 10px;
          min-height: 72px;
        }

        .lesson-title {
          font-size: 13px;
        }

        .lesson-content {
          padding: 0 0 22px;
        }

        .contact {
          padding: 65px 6% 70px;
        }

        footer {
          padding: 22px 6%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <a class="wordmark" href="/" aria-label="Trading Mind home">
        <strong>trading</strong><span>mind</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="/" >Home</a>
        <a href="/course" aria-current="page">Free course</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <h1>
            The trading
            <span>course.</span>
          </h1>

          <p class="hero-description">
            A free video course covering market structure, liquidity,
            volatility, volume profile, orderflow and trading psychology.
            Work through the lessons at your own pace.
          </p>

          <div class="course-meta">
            <span>9 lessons</span>
            <span>Plus Q&amp;A</span>
            <span>Free access</span>
          </div>
        </div>
      </section>

      <section class="curriculum" id="lessons">
        <div class="curriculum-inner">
          <div class="curriculum-heading">
            <h2>Course lessons</h2>
            <p>Select a lesson to watch the video.</p>
          </div>

          {lessons.map((lesson) => (
            <details class="lesson" id={`lesson-${lesson.number}`}>
              <summary>
                <span class="lesson-number">{lesson.number}</span>
                <span class="lesson-title">{lesson.title}</span>
                <span class="lesson-toggle" aria-hidden="true"></span>
              </summary>

              <div class="lesson-content">
                <div class="video-wrap">
                  <iframe
                    src={`https://iframe.videodelivery.net/${lesson.id}`}
                    title={lesson.title}
                    loading="lazy"
                    allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            </details>
          ))}

          <details class="lesson" id="lesson-qa">
            <summary>
              <span class="lesson-number">{bonus.number}</span>
              <span class="lesson-title">{bonus.title}</span>
              <span class="lesson-toggle" aria-hidden="true"></span>
            </summary>

            <div class="lesson-content">
              <div class="video-wrap">
                <iframe
                  src={`https://iframe.videodelivery.net/${bonus.id}`}
                  title={bonus.title}
                  loading="lazy"
                  allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          </details>
        </div>
      </section>

      <section class="contact" id="coaching">
        <h2>Interested in working together?</h2>
        <p>
          If you'd like to explore one-to-one coaching focused on your
          capacity to navigate the demands of trading, get in touch.
        </p>

        <a
          class="button"
          href="https://x.com/youngtilopa"
          target="_blank"
          rel="noopener noreferrer"
        >
          Enquire about 1:1 coaching
        </a>
      </section>
    </main>

    <footer>
      <a class="wordmark" href="/" aria-label="Trading Mind home">
        <strong>trading</strong><span>mind</span>
      </a>
      <p>© {year} Trading Mind</p>
    </footer>
  </body>
</html>
