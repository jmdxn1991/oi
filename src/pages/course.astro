
---
const year = new Date().getFullYear();

const lessons = [
  {
    title: "Market Microstructure and Liquidity Basics",
    description: "Understand the foundations of market microstructure and liquidity.",
    id: "ece8e22d4c8bab1080123059337a5efd",
  },
  {
    title: "Identifying Key Structures (Flags and Flag Limits)",
    description: "Explore flags, flag limits and the structures traders watch.",
    id: "7195a57d5c24c8c7884cde1ad3aba05e",
  },
  {
    title: "Market Structure (Engulf and FTR)",
    description: "An introduction to engulfing structures and failure to return.",
    id: "e0bdd98b82052e3e13fa1407c672e1bc",
  },
  {
    title: "Anticipating Volatility (Liquidity Gaps and Compression)",
    description: "Look at liquidity gaps, compression and potential changes in volatility.",
    id: "90a1f82e53168f5ca2f47c85b90ac971",
  },
  {
    title: "Navigating Scale (Trading Flow and Managing Expectations)",
    description: "Consider trading flow across scales and managing expectations.",
    id: "799078cd2ca73d29cbb9b3901cb3971a",
  },
  {
    title: "Volume Profile",
    description: "Explore volume profile and how it can inform market analysis.",
    id: "4075efd8f38c2ff75d860bd2f2202ea6",
  },
  {
    title: "False Breaks",
    description: "Examine false breaks and how they appear in market structure.",
    id: "48fb22e7eecdea58ba7ac2f24b2dd950",
  },
  {
    title: "Orderflow Dynamics and the Footprint",
    description: "Explore orderflow dynamics and reading the footprint.",
    id: "868cdd5af104fafc12705f9e01671186",
  },
  {
    title: "Psychology",
    description: "Consider the psychological side of trading and decision-making.",
    id: "a4ad8289e0b0997dc64dbc48f7ce38bc",
  },
];

const bonus = {
  title: "Final Q&A",
  description: "A bonus question-and-answer session to close out the course.",
  id: "f2b36697fc2208c7b44b2760d3a9aab0",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A free trading course covering market structure, liquidity, volatility, orderflow and psychology."
    />
    <meta name="theme-color" content="#f7f6f2" />
    <title>Free Trading Course — Trading Mind</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Trading Mind home">trading<span>mind</span></a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="/#approach">Approach</a>
        <a class="nav-course" href="/course">Free course</a>
      </nav>
    </header>

    <main>
      <section class="course-hero">
        <h1>Build your understanding of the <em>markets.</em></h1>
        <p class="course-intro">
          A collection of lessons exploring market structure, liquidity,
          volatility, orderflow and trading psychology. Work through the
          sessions at your own pace.
        </p>
        <div class="course-meta">
          <span><span class="meta-dot"></span> 9 lessons + bonus Q&amp;A</span>
          <span>Free access</span>
          <span>Watch at your own pace</span>
        </div>
      </section>

      <section class="lessons-section">
        <div class="lessons-heading">
          <h2>Course lessons</h2>
          <p class="lessons-note">Start at the beginning or jump to the topic you're interested in.</p>
        </div>

        <div class="lesson-list">
          {lessons.map((lesson, index) => (
            <article class="lesson" id={`lesson-${index + 1}`}>
              <div class="lesson-info">
                <p class="lesson-number">{String(index + 1).padStart(2, "0")}</p>
                <div>
                  <h3>{lesson.title}</h3>
                  <p>{lesson.description}</p>
                </div>
              </div>
              <details class="lesson-details">
                <summary>
                  <span class="watch-label">Watch lesson</span>
                  <span class="plus">+</span>
                </summary>
                <div class="video-wrap">
                  <iframe
                    src={`https://iframe.videodelivery.net/${lesson.id}`}
                    title={lesson.title}
                    loading="lazy"
                    allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
                    allowfullscreen
                  ></iframe>
                </div>
              </details>
            </article>
          ))}
        </div>

        <article class="lesson bonus-lesson" id="bonus">
          <div class="lesson-info">
            <p class="lesson-number">+</p>
            <div>
              <h3>{bonus.title}</h3>
              <p>{bonus.description}</p>
            </div>
          </div>
          <details class="lesson-details">
            <summary>
              <span class="watch-label">Watch session</span>
              <span class="plus">+</span>
            </summary>
            <div class="video-wrap">
              <iframe
                src={`https://iframe.videodelivery.net/${bonus.id}`}
                title={bonus.title}
                loading="lazy"
                allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
                allowfullscreen
              ></iframe>
            </div>
          </details>
        </article>
      </section>

      <section class="course-cta">
        <h2>The person behind the trader matters, too.</h2>
        <p>
          Alongside market knowledge, explore how you relate to pressure,
          uncertainty and the demands of trading.
        </p>
        <a class="button button-dark" href="/#contact">Enquire about 1:1 coaching</a>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand footer-brand" href="/">trading<span>mind</span></a>
      <p class="copyright">© {year} Trading Mind</p>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #f7f6f2;
    --ink: #262822;
    --muted: #77796f;
    --olive: #858c70;
    --line: #deded5;
    --soft: #eeeee7;
  }

  :global(*) { box-sizing: border-box; }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
  }

  :global(body) {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  :global(a), :global(a:visited) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid var(--olive); outline-offset: 5px; }

  .site-header {
    min-height: 86px;
    padding: 0 7.2%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -1.25px;
    line-height: 1;
  }

  .brand > span { font-weight: 400; }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(17px, 2.6vw, 38px);
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    color: #55574f;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .nav-links a:hover, .nav-links .nav-course { color: var(--olive); }

  h1, h2, h3, p { margin-top: 0; }

  h1 {
    max-width: 850px;
    margin-bottom: 25px;
    font-size: clamp(44px, 6.5vw, 78px);
    font-weight: 450;
    letter-spacing: -4px;
    line-height: 1.07;
  }

  h1 em { color: var(--olive); font-style: normal; }

  .course-hero {
    padding: 100px 7.2% 70px;
    border-bottom: 1px solid var(--line);
  }

  .course-intro {
    max-width: 630px;
    margin-bottom: 32px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.95;
  }

  .course-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 13px 28px;
    color: var(--muted);
    font-size: 11px;
  }

  .meta-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 8px 1px 0;
    border-radius: 50%;
    background: var(--olive);
  }

  .lessons-section { padding: 78px 7.2% 90px; }

  .lessons-heading {
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 35px;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(30px, 4vw, 43px);
    font-weight: 450;
    letter-spacing: -1.7px;
    line-height: 1.2;
  }

  .lessons-note {
    max-width: 300px;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 12px;
  }

  .lesson-list { border-top: 1px solid var(--line); }

  .lesson {
    padding: 25px 0;
    border-bottom: 1px solid var(--line);
  }

  .lesson-info {
    display: grid;
    grid-template-columns: 45px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .lesson-number {
    margin: 3px 0 0;
    color: var(--olive);
    font-size: 11px;
    letter-spacing: 1px;
  }

  .lesson h3 {
    margin-bottom: 5px;
    font-size: 17px;
    font-weight: 550;
    letter-spacing: -0.35px;
    line-height: 1.5;
  }

  .lesson-info div > p:last-child {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .lesson-details { margin: 15px 0 0 57px; }

  .lesson-details summary {
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 13px;
    cursor: pointer;
    list-style: none;
  }

  .lesson-details summary::-webkit-details-marker { display: none; }

  .watch-label {
    color: var(--ink);
    font-size: 11px;
    font-weight: 550;
  }

  .plus {
    width: 23px;
    height: 23px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d2d3c8;
    border-radius: 50%;
    color: var(--olive);
    font-size: 15px;
    line-height: 1;
    transition: transform 160ms ease;
  }

  details[open] .plus { transform: rotate(45deg); }

  .video-wrap {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin-top: 20px;
    overflow: hidden;
    background: #e8e8e0;
    aspect-ratio: 16 / 9;
  }

  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .bonus-lesson {
    margin-top: 24px;
    padding: 28px;
    background: var(--soft);
    border: 0;
  }

  .bonus-lesson .lesson-details { margin-left: 57px; }

  .course-cta {
    padding: 78px 7.2% 90px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-top: 1px solid var(--line);
  }

  .course-cta h2 {
    max-width: 660px;
    font-size: clamp(32px, 4.5vw, 48px);
  }

  .course-cta > p {
    max-width: 570px;
    margin: 18px 0 25px;
    color: var(--muted);
    font-size: 14px;
  }

  .button, .button:visited {
    min-height: 47px;
    padding: 0 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: #fff !important;
    font-size: 12px;
    font-weight: 550;
    transition: background 160ms ease;
  }

  .button:hover { background: #45483d; }

  .site-footer {
    min-height: 83px;
    padding: 22px 7.2%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid var(--line);
  }

  .footer-brand { font-size: 18px; }
  .site-footer p { margin: 0; color: var(--muted); font-size: 11px; }

  @media (min-width: 1500px) {
    .site-header, .course-hero, .lessons-section, .course-cta, .site-footer {
      padding-left: max(7.2%, calc((100vw - 1240px) / 2));
      padding-right: max(7.2%, calc((100vw - 1240px) / 2));
    }
  }

  @media (max-width: 760px) {
    .site-header {
      min-height: auto;
      padding: 23px 6%;
      align-items: flex-start;
      flex-direction: column;
      gap: 21px;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 12px 21px;
    }

    .nav-links a { font-size: 12px; }

    .course-hero { padding: 72px 6% 52px; }
    h1 { font-size: clamp(43px, 10vw, 65px); letter-spacing: -2.8px; }
    .lessons-section { padding: 58px 6% 65px; }
    .lessons-heading { align-items: flex-start; flex-direction: column; gap: 13px; }
    .lesson-info { grid-template-columns: 31px minmax(0, 1fr); gap: 9px; }
    .lesson-details, .bonus-lesson .lesson-details { margin-left: 40px; }
    .bonus-lesson { padding: 20px 15px; }
    .course-cta { padding: 62px 6% 70px; }
    .site-footer { padding: 24px 6%; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    :global(*), :global(*::before), :global(*::after) { transition: none !important; }
  }
</style>
