import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Trading Mind — Coaching for Traders"
      description="One-to-one Organic Intelligence coaching for traders. Develop the capacity to meet uncertainty, stress and the demands of trading."
    />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">Trading Mind</a>
      <nav>
        <a href="/course">Free Course ↗</a>
        <a href="#contact">Coaching ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">ORGANIC INTELLIGENCE FOR TRADERS</p>

        <h1>
          Trading puts your nervous system under pressure<span>.</span>
        </h1>

        <p class="intro">Your capacity matters as much as your strategy.</p>

        <p class="description">
          One-to-one coaching for traders navigating uncertainty, stress and
          the psychological demands of the markets.
        </p>

        <a class="button" href="#contact">Explore coaching <span>↗</span></a>

        <div class="hero-bottom">
          <span>01</span>
          <span>BEYOND STRATEGY. BEYOND WILLPOWER.</span>
        </div>
      </section>

      <section class="approach" id="approach">
        <p class="eyebrow">A DIFFERENT APPROACH</p>

        <h2>
          You can know exactly what to do — and still struggle to do it.
        </h2>

        <div class="approach-copy">
          <p>
            Uncertainty, volatility, wins, losses and the urge to act all place
            demands on you. More discipline and better rules don't necessarily
            address the whole problem.
          </p>

          <p>
            Organic Intelligence is a nervous-system-informed approach to
            developing capacity. Rather than trying to force yourself into the
            right state, we work with your experience as it unfolds — building
            a more flexible relationship with pressure over time.
